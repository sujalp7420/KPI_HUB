@model KPI_HUB.Models.ViewModels.CreateMarketingCampaignViewModel
@{
    ViewData["Title"] = "New Marketing Campaign";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <div class="panel-card shadow-sm border-0 p-4">
            <h5 class="fw-bold mb-3">Create Marketing Campaign</h5>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label small fw-bold text-muted">CAMPAIGN NAME *</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Q3 Growth Google Search" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="Platform" class="form-label small fw-bold text-muted">MARKETING CHANNEL / PLATFORM *</label>
                        <select asp-for="Platform" class="form-select" required>
                            <option value="Google Ads">Google Ads</option>
                            <option value="Meta Ads (FB/IG)">Meta Ads (FB/IG)</option>
                            <option value="LinkedIn Ads">LinkedIn Ads</option>
                            <option value="Email Newsletter">Email Newsletter</option>
                            <option value="Influencer Marketing">Influencer Marketing</option>
                            <option value="SEO & Content">SEO & Content</option>
                            <option value="Other Channel">Other Channel</option>
                        </select>
                        <span asp-validation-for="Platform" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Status" class="form-label small fw-bold text-muted">STATUS</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Active">Active</option>
                            <option value="Completed">Completed</option>
                            <option value="Paused">Paused</option>
                            <option value="Planned">Planned</option>
                        </select>
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="Budget" class="form-label small fw-bold text-muted">BUDGET ALLOCATED (₹)</label>
                        <input asp-for="Budget" type="number" step="0.01" class="form-control" placeholder="0.00" />
                        <span asp-validation-for="Budget" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="ActualCost" class="form-label small fw-bold text-muted">ACTUAL AMOUNT SPENT (₹) *</label>
                        <input asp-for="ActualCost" type="number" step="0.01" class="form-control" placeholder="0.00" required />
                        <span asp-validation-for="ActualCost" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-sm-4">
                        <label asp-for="Leads" class="form-label small fw-bold text-muted">LEADS GENERATED</label>
                        <input asp-for="Leads" type="number" class="form-control" placeholder="0" />
                        <span asp-validation-for="Leads" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-4">
                        <label asp-for="CustomersAcquired" class="form-label small fw-bold text-muted">CUSTOMERS ACQUIRED</label>
                        <input asp-for="CustomersAcquired" type="number" class="form-control" placeholder="0" />
                        <span asp-validation-for="CustomersAcquired" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-4">
                        <label asp-for="RevenueGenerated" class="form-label small fw-bold text-muted">REVENUE GENERATED (₹)</label>
                        <input asp-for="RevenueGenerated" type="number" step="0.01" class="form-control" placeholder="0.00" />
                        <span asp-validation-for="RevenueGenerated" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-2 mb-4">
                    <div class="col-sm-6">
                        <label asp-for="StartDate" class="form-label small fw-bold text-muted">START DATE</label>
                        <input asp-for="StartDate" type="date" class="form-control" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="EndDate" class="form-label small fw-bold text-muted">END DATE</label>
                        <input asp-for="EndDate" type="date" class="form-control" value="@DateTime.UtcNow.AddDays(30).ToString("yyyy-MM-dd")" />
                    </div>
                </div>

                <div class="d-flex justify-content-between pt-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save Campaign</button>
                </div>
            </form>
        </div>
    </div>
</div>
