@model IEnumerable<KPI_HUB.Models.ViewModels.CustomerListViewModel>
@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h4 class="fw-bold mb-1">Customer Management</h4>
        <p class="text-muted mb-0">Track customer lifetime value, purchases, and registration growth</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="bi bi-person-plus me-1"></i> Add Customer
    </a>
</div>

<div class="panel-card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Contact</th>
                    <th>Total Spend</th>
                    <th>Joined</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var customer in Model)
                    {
                        <tr>
                            <td class="fw-semibold">
                                <a asp-action="Details" asp-route-id="@customer.Id" class="text-decoration-none text-dark fw-bold">
                                    @customer.Name
                                </a>
                            </td>
                            <td>
                                <div>@customer.Email</div>
                                <small class="text-muted">@(customer.Phone ?? "-")</small>
                            </td>
                            <td class="fw-bold text-success">₹@customer.TotalPurchases.ToString("N2")</td>
                            <td>@customer.RegistrationDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                <span class="badge @(customer.Status == "Active" ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">
                                    @customer.Status
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@customer.Id" class="btn btn-outline-secondary" title="View Profile">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@customer.Id" class="btn btn-outline-secondary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@customer.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this customer?');">
                                        <button type="submit" class="btn btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">No customers found. Click "Add Customer" to create one.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
