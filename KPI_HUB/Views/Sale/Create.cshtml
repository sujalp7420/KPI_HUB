@model KPI_HUB.Models.ViewModels.CreateSaleViewModel
@{
    ViewData["Title"] = "Record Sale";
    var customers = ViewBag.Customers as IEnumerable<KPI_HUB.Models.ViewModels.CustomerListViewModel> ?? Enumerable.Empty<KPI_HUB.Models.ViewModels.CustomerListViewModel>();
    var products = ViewBag.Products as IEnumerable<KPI_HUB.Models.ViewModels.ProductListViewModel> ?? Enumerable.Empty<KPI_HUB.Models.ViewModels.ProductListViewModel>();
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="panel-card shadow-sm border-0 p-4">
            <h5 class="fw-bold mb-3">Record New Sale / Order</h5>

            <form asp-action="Create" method="post" id="saleForm">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>

                <div class="row g-3 mb-4">
                    <div class="col-md-5">
                        <label asp-for="CustomerId" class="form-label small fw-bold text-muted">SELECT CUSTOMER *</label>
                        <select asp-for="CustomerId" class="form-select" required>
                            <option value="">-- Choose Customer --</option>
                            @foreach (var c in customers)
                            {
                                <option value="@c.Id">@c.Name (@c.Email)</option>
                            }
                        </select>
                        <span asp-validation-for="CustomerId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="SaleDate" class="form-label small fw-bold text-muted">SALE DATE *</label>
                        <input asp-for="SaleDate" type="datetime-local" class="form-control" value="@DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm")" required />
                        <span asp-validation-for="SaleDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-2">
                        <label asp-for="PaymentMethod" class="form-label small fw-bold text-muted">PAYMENT</label>
                        <select asp-for="PaymentMethod" class="form-select">
                            <option value="Card">Card</option>
                            <option value="Bank Transfer">Bank Transfer</option>
                            <option value="UPI">UPI</option>
                            <option value="Cash">Cash</option>
                            <option value="Invoice Net-30">Invoice Net-30</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label asp-for="Status" class="form-label small fw-bold text-muted">STATUS</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Completed">Completed</option>
                            <option value="Pending">Pending</option>
                            <option value="Draft">Draft</option>
                        </select>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="fw-bold mb-0">Order Items</h6>
                    <button type="button" class="btn btn-outline-primary btn-sm" id="addItemBtn">
                        <i class="bi bi-plus-lg me-1"></i> Add Product
                    </button>
                </div>

                <div class="table-responsive mb-4">
                    <table class="table align-middle" id="itemsTable">
                        <thead>
                            <tr>
                                <th style="width: 45%;">Product</th>
                                <th style="width: 20%;">Unit Price (₹)</th>
                                <th style="width: 15%;">Quantity</th>
                                <th style="width: 15%;">Subtotal (₹)</th>
                                <th style="width: 5%;"></th>
                            </tr>
                        </thead>
                        <tbody id="itemsContainer">
                            <tr class="item-row">
                                <td>
                                    <select name="Items[0].ProductId" class="form-select product-select" required>
                                        <option value="">-- Choose Product --</option>
                                        @foreach (var p in products)
                                        {
                                            <option value="@p.Id" data-price="@p.Price" data-stock="@p.StockQuantity">
                                                @p.Name (₹@p.Price, Stock: @p.StockQuantity)
                                            </option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input type="number" step="0.01" name="Items[0].UnitPrice" class="form-control item-price" placeholder="0.00" required />
                                </td>
                                <td>
                                    <input type="number" min="1" value="1" name="Items[0].Quantity" class="form-control item-qty" required />
                                </td>
                                <td>
                                    <input type="text" readonly class="form-control-plaintext fw-bold text-end item-total" value="₹0.00" />
                                </td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-outline-danger remove-item-btn"><i class="bi bi-x-lg"></i></button>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-end fw-bold fs-6">Grand Total:</td>
                                <td>
                                    <span class="fs-5 fw-bold text-success text-end d-block" id="grandTotalText">₹0.00</span>
                                </td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="d-flex justify-content-between pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4">Save and Create Invoice</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        let rowIndex = 1;
        const container = document.getElementById("itemsContainer");
        const addBtn = document.getElementById("addItemBtn");
        const grandTotalText = document.getElementById("grandTotalText");

        function calculateTotals() {
            let grandTotal = 0;
            const rows = container.querySelectorAll(".item-row");
            rows.forEach(row => {
                const price = parseFloat(row.querySelector(".item-price").value) || 0;
                const qty = parseInt(row.querySelector(".item-qty").value) || 0;
                const subtotal = price * qty;
                row.querySelector(".item-total").value = '₹' + subtotal.toFixed(2);
                grandTotal += subtotal;
            });
            grandTotalText.innerText = '₹' + grandTotal.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        container.addEventListener("change", function (e) {
            if (e.target.classList.contains("product-select")) {
                const selectedOpt = e.target.options[e.target.selectedIndex];
                const price = selectedOpt.getAttribute("data-price") || 0;
                const row = e.target.closest(".item-row");
                row.querySelector(".item-price").value = price;
                calculateTotals();
            }
        });

        container.addEventListener("input", function (e) {
            if (e.target.classList.contains("item-price") || e.target.classList.contains("item-qty")) {
                calculateTotals();
            }
        });

        container.addEventListener("click", function (e) {
            const btn = e.target.closest(".remove-item-btn");
            if (btn && container.querySelectorAll(".item-row").length > 1) {
                btn.closest(".item-row").remove();
                reindexRows();
                calculateTotals();
            }
        });

        addBtn.addEventListener("click", function () {
            const firstRow = container.querySelector(".item-row");
            const newRow = firstRow.cloneNode(true);
            newRow.querySelector(".product-select").selectedIndex = 0;
            newRow.querySelector(".item-price").value = "";
            newRow.querySelector(".item-qty").value = "1";
            newRow.querySelector(".item-total").value = "₹0.00";
            container.appendChild(newRow);
            reindexRows();
        });

        function reindexRows() {
            const rows = container.querySelectorAll(".item-row");
            rows.forEach((row, idx) => {
                row.querySelector(".product-select").name = `Items[${idx}].ProductId`;
                row.querySelector(".item-price").name = `Items[${idx}].UnitPrice`;
                row.querySelector(".item-qty").name = `Items[${idx}].Quantity`;
            });
        }

        calculateTotals();
    });
</script>
}
