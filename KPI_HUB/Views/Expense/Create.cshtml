@model KPI_HUB.Models.ViewModels.CreateExpenseViewModel
@{
    ViewData["Title"] = "Record Expense";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="panel-card shadow-sm border-0 p-4">
            <h5 class="fw-bold mb-3">Record Startup Expense</h5>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>

                <div class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="Date" class="form-label small fw-bold text-muted">DATE *</label>
                        <input asp-for="Date" type="date" class="form-control" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" required />
                        <span asp-validation-for="Date" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Amount" class="form-label small fw-bold text-muted">AMOUNT (₹) *</label>
                        <input asp-for="Amount" type="number" step="0.01" class="form-control" placeholder="0.00" required />
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="Category" class="form-label small fw-bold text-muted">EXPENSE CATEGORY *</label>
                        <select asp-for="Category" class="form-select" required>
                            <option value="Salary">Salary / Payroll</option>
                            <option value="Marketing">Marketing / Advertising</option>
                            <option value="Software">Software / SaaS Subscriptions</option>
                            <option value="Rent">Office Rent / Coworking</option>
                            <option value="Electricity">Electricity / Utilities</option>
                            <option value="Travel">Travel & Lodging</option>
                            <option value="Office">Office Supplies / Pantry</option>
                            <option value="Equipment">Equipment / Hardware</option>
                            <option value="Other">Other Operational Cost</option>
                        </select>
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="PaymentMethod" class="form-label small fw-bold text-muted">PAYMENT METHOD</label>
                        <select asp-for="PaymentMethod" class="form-select">
                            <option value="Bank Transfer">Bank Transfer</option>
                            <option value="Company Card">Company Card</option>
                            <option value="UPI">UPI</option>
                            <option value="Cash / Petty Cash">Cash / Petty Cash</option>
                            <option value="Reimbursement">Reimbursement</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Vendor" class="form-label small fw-bold text-muted">VENDOR / PAYEE</label>
                    <input asp-for="Vendor" class="form-control" placeholder="e.g. AWS, Google Ads, WeWork" />
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label small fw-bold text-muted">DESCRIPTION</label>
                    <input asp-for="Description" class="form-control" placeholder="Brief note on what this expense is for" />
                </div>

                <div class="mb-4">
                    <label asp-for="Notes" class="form-label small fw-bold text-muted">ADDITIONAL NOTES / RECEIPT REF</label>
                    <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Optional notes"></textarea>
                </div>

                <div class="d-flex justify-content-between pt-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save Expense</button>
                </div>
            </form>
        </div>
    </div>
</div>
