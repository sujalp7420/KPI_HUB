@model KPI_HUB.Models.ViewModels.CustomerGrowthViewModel
@{
    ViewData["Title"] = "Customer Growth Report";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h4 class="fw-bold mb-1">Customer Acquisition & Growth Metrics</h4>
        <p class="text-muted mb-0">Total customer counts, new registrations, and period-over-period percentage growth</p>
    </div>
</div>

<!-- Date Filter Bar -->
<div class="panel-card shadow-sm border-0 mb-4 py-3">
    <form asp-action="CustomerGrowth" method="get" class="row g-2 align-items-end">
        <div class="col-sm-4">
            <label class="small fw-bold text-muted">FROM DATE</label>
            <input type="date" name="start" value="@ViewBag.StartDate" class="form-control form-control-sm" />
        </div>
        <div class="col-sm-4">
            <label class="small fw-bold text-muted">TO DATE</label>
            <input type="date" name="end" value="@ViewBag.EndDate" class="form-control form-control-sm" />
        </div>
        <div class="col-sm-4">
            <button type="submit" class="btn btn-primary btn-sm w-100">Filter Range</button>
        </div>
    </form>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="kpi-card py-3">
            <span class="kpi-label">Total Customer Base</span>
            <div class="kpi-val text-primary">@Model.TotalCustomers</div>
            <div class="kpi-sub text-muted">All registered accounts</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="kpi-card py-3">
            <span class="kpi-label">New Customers (Period)</span>
            <div class="kpi-val text-success">@Model.NewCustomers</div>
            <div class="kpi-sub text-muted">Joined in filtered window</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="kpi-card py-3">
            <span class="kpi-label">Acquisition Growth Rate</span>
            <div class="kpi-val text-dark">@Model.GrowthRate%</div>
            <div class="kpi-sub text-muted">Percentage base expansion</div>
        </div>
    </div>
</div>

<div class="panel-card shadow-sm border-0">
    <h5 class="panel-title mb-3"><i class="bi bi-calendar-month text-info me-2"></i>Monthly Acquisition Log</h5>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Month / Year</th>
                    <th class="text-end">New Customers Registered</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.MonthlyGrowth.Any())
                {
                    @foreach (var m in Model.MonthlyGrowth)
                    {
                        <tr>
                            <td class="fw-semibold">@m.Label</td>
                            <td class="text-end fw-bold text-success">@m.Value</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="2" class="text-center py-4 text-muted">No registration data in selected range.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
