@model KPI_HUB.Models.ViewModels.ProductSalesReportViewModel
@{
    ViewData["Title"] = "Product Performance Report";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h4 class="fw-bold mb-1">Product Sales & Profitability Report</h4>
        <p class="text-muted mb-0">Ranking top performing products by sales volume, gross revenue, and product profit</p>
    </div>
</div>

<!-- Date Filter Bar -->
<div class="panel-card shadow-sm border-0 mb-4 py-3">
    <form asp-action="ProductSales" method="get" class="row g-2 align-items-end">
        <div class="col-sm-4">
            <label class="small fw-bold text-muted">FROM DATE</label>
            <input type="date" name="start" value="@ViewBag.StartDate" class="form-control form-control-sm" />
        </div>
        <div class="col-sm-4">
            <label class="small fw-bold text-muted">TO DATE</label>
            <input type="date" name="end" value="@ViewBag.EndDate" class="form-control form-control-sm" />
        </div>
        <div class="col-sm-4">
            <button type="submit" class="btn btn-primary btn-sm w-100">Filter Range</button>
        </div>
    </form>
</div>

<div class="panel-card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Units Sold</th>
                    <th>Gross Revenue</th>
                    <th>Gross Profit Contribution</th>
                    <th class="text-end">Margin %</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.TopProducts.Any())
                {
                    @foreach (var p in Model.TopProducts)
                    {
                        var margin = p.RevenueGenerated > 0 ? Math.Round((p.ProductProfit / p.RevenueGenerated) * 100m, 1) : 0m;
                        <tr>
                            <td class="fw-bold">@p.ProductName</td>
                            <td class="fw-semibold text-primary">@p.QuantitySold units</td>
                            <td class="fw-semibold">₹@p.RevenueGenerated.ToString("N2")</td>
                            <td class="fw-bold text-success">₹@p.ProductProfit.ToString("N2")</td>
                            <td class="text-end">
                                <span class="badge @(margin > 40 ? "bg-success" : "bg-primary")">
                                    @margin%
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">No product sales in the selected date range.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
