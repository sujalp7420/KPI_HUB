@model KPI_HUB.Models.ViewModels.RevenueReportViewModel
@{
    ViewData["Title"] = "Revenue Analysis Report";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h4 class="fw-bold mb-1">Revenue Inflow Breakdown</h4>
        <p class="text-muted mb-0">Analysis by sales channel, month-over-month trajectory, and top contributing clients</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportExcel" asp-route-type="revenue" asp-route-start="@ViewBag.StartDate" asp-route-end="@ViewBag.EndDate" class="btn btn-outline-success btn-sm">
            <i class="bi bi-file-earmark-excel me-1"></i> Download Excel
        </a>
    </div>
</div>

<!-- Date Filter Bar -->
<div class="panel-card shadow-sm border-0 mb-4 py-3">
    <form asp-action="Revenue" method="get" class="row g-2 align-items-end">
        <div class="col-sm-4">
            <label class="small fw-bold text-muted">FROM DATE</label>
            <input type="date" name="start" value="@ViewBag.StartDate" class="form-control form-control-sm" />
        </div>
        <div class="col-sm-4">
            <label class="small fw-bold text-muted">TO DATE</label>
            <input type="date" name="end" value="@ViewBag.EndDate" class="form-control form-control-sm" />
        </div>
        <div class="col-sm-4">
            <button type="submit" class="btn btn-primary btn-sm w-100">Filter Range</button>
        </div>
    </form>
</div>

<div class="row g-4">
    <!-- By Source Breakdown -->
    <div class="col-lg-6">
        <div class="panel-card shadow-sm border-0 h-100">
            <h5 class="panel-title mb-3"><i class="bi bi-pie-chart text-primary me-2"></i>Revenue by Channel / Stream</h5>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Channel / Stream</th>
                            <th class="text-end">Total Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.BySource)
                        {
                            <tr>
                                <td class="fw-semibold">@s.Source</td>
                                <td class="text-end fw-bold text-primary">₹@s.Value.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- By Top Clients -->
    <div class="col-lg-6">
        <div class="panel-card shadow-sm border-0 h-100">
            <h5 class="panel-title mb-3"><i class="bi bi-person-check text-success me-2"></i>Top Contributing Clients</h5>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Client</th>
                            <th class="text-end">Contribution</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.ByCustomer)
                        {
                            <tr>
                                <td class="fw-semibold">@c.CustomerName</td>
                                <td class="text-end fw-bold text-success">₹@c.Value.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
