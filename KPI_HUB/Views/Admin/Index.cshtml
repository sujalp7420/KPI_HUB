@model IEnumerable<KPI_HUB.Models.ViewModels.AdminUserViewModel>
@{
    ViewData["Title"] = "User & Access Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">System Administration</h4>
        <p class="text-muted mb-0">Manage registered users, team members, and role permissions</p>
    </div>
</div>

<div class="panel-card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Assigned Roles</th>
                    <th>Registration Date</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="fw-semibold">
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar-circle">
                                    @(user.FullName.Length > 0 ? user.FullName[0].ToString().ToUpper() : "U")
                                </div>
                                <span>@user.FullName</span>
                            </div>
                        </td>
                        <td class="text-muted">@user.Email</td>
                        <td>
                            @foreach (var role in user.Roles)
                            {
                                var badgeBg = role switch
                                {
                                    "Admin" => "bg-danger",
                                    "Founder" => "bg-primary",
                                    "Manager" => "bg-warning text-dark",
                                    "Accountant" => "bg-info text-dark",
                                    _ => "bg-secondary"
                                };
                                <span class="badge @badgeBg me-1">@role</span>
                            }
                        </td>
                        <td>@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td>
                            <span class="badge bg-success-subtle text-success">Active</span>
                        </td>
                        <td class="text-end">
                            <a asp-action="ManageRoles" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-shield-check me-1"></i> Change Roles
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
