@model KPI_HUB.Models.ViewModels.ProductFormViewModel
@{
    ViewData["Title"] = "Edit Product";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <div class="panel-card shadow-sm border-0 p-4">
            <h5 class="fw-bold mb-3">Edit Product / Service</h5>

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label small fw-bold text-muted">PRODUCT / SERVICE NAME *</label>
                    <input asp-for="Name" class="form-control" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="Category" class="form-label small fw-bold text-muted">CATEGORY *</label>
                        <select asp-for="Category" class="form-select" required>
                            <option value="Software">Software / SaaS</option>
                            <option value="Service">Service / Consulting</option>
                            <option value="Physical Product">Physical Product</option>
                            <option value="Subscription">Subscription</option>
                            <option value="Digital Good">Digital Good</option>
                            <option value="Other">Other</option>
                        </select>
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Status" class="form-label small fw-bold text-muted">STATUS</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                            <option value="Draft">Draft</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="Price" class="form-label small fw-bold text-muted">SELLING PRICE (₹) *</label>
                        <input asp-for="Price" type="number" step="0.01" class="form-control" required />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="CostPrice" class="form-label small fw-bold text-muted">COST PRICE / COGS (₹) *</label>
                        <input asp-for="CostPrice" type="number" step="0.01" class="form-control" required />
                        <span asp-validation-for="CostPrice" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="StockQuantity" class="form-label small fw-bold text-muted">CURRENT STOCK QUANTITY</label>
                        <input asp-for="StockQuantity" type="number" class="form-control" />
                        <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="MinimumStock" class="form-label small fw-bold text-muted">MINIMUM REORDER LEVEL</label>
                        <input asp-for="MinimumStock" type="number" class="form-control" />
                        <span asp-validation-for="MinimumStock" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label small fw-bold text-muted">DESCRIPTION</label>
                    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between pt-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Update Product</button>
                </div>
            </form>
        </div>
    </div>
</div>
