@model KPI_HUB.Models.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "User Profile";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="panel-card shadow-sm border-0 p-4">
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                <div class="avatar-circle" style="width: 54px; height: 54px; font-size: 1.4rem;">
                    @(Model.FullName.Length > 0 ? Model.FullName[0].ToString().ToUpper() : "U")
                </div>
                <div>
                    <h5 class="fw-bold mb-0">@Model.FullName</h5>
                    <span class="text-muted small">@Model.Email</span>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-sm-6">
                    <label class="form-label small fw-bold text-muted">ROLES & PERMISSIONS</label>
                    <div>
                        @foreach (var role in Model.Roles)
                        {
                            <span class="badge bg-primary me-1">@role</span>
                        }
                    </div>
                </div>
                <div class="col-sm-6">
                    <label class="form-label small fw-bold text-muted">ACCOUNT CREATED</label>
                    <div class="fw-semibold">@Model.CreatedAt.ToString("MMM dd, yyyy")</div>
                </div>
                <div class="col-sm-12">
                    <label class="form-label small fw-bold text-muted">PHONE NUMBER</label>
                    <div class="fw-semibold">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not provided" : Model.PhoneNumber)</div>
                </div>
            </div>

            <div class="d-flex justify-content-between pt-3 border-top">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary btn-sm">&larr; Back to Dashboard</a>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-outline-danger btn-sm">Sign Out</button>
                </form>
            </div>
        </div>
    </div>
</div>
