@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 text-center">
        <div class="panel-card shadow-sm border-0 p-5">
            <i class="bi bi-shield-x text-danger display-3 mb-3"></i>
            <h3 class="fw-bold">Access Denied</h3>
            <p class="text-muted">You do not have the required permissions or role to access this resource.</p>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary mt-3">Return to Dashboard</a>
        </div>
    </div>
</div>
