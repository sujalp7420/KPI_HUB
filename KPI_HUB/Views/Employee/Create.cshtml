@model KPI_HUB.Models.ViewModels.CreateEmployeeViewModel
@{
    ViewData["Title"] = "Add Employee";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="panel-card shadow-sm border-0 p-4">
            <h5 class="fw-bold mb-3">Add Team Member</h5>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label small fw-bold text-muted">EMPLOYEE FULL NAME *</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Maya Lin" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="Email" class="form-label small fw-bold text-muted">EMAIL ADDRESS *</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="maya@startup.com" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Phone" class="form-label small fw-bold text-muted">PHONE NUMBER</label>
                        <input asp-for="Phone" class="form-control" placeholder="+91 9876543210" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="Department" class="form-label small fw-bold text-muted">DEPARTMENT</label>
                        <select asp-for="Department" class="form-select">
                            <option value="Engineering">Engineering</option>
                            <option value="Product">Product & Design</option>
                            <option value="Sales">Sales & Business Dev</option>
                            <option value="Marketing">Marketing & Growth</option>
                            <option value="Finance">Finance & Accounting</option>
                            <option value="Operations">Operations & HR</option>
                        </select>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Position" class="form-label small fw-bold text-muted">DESIGNATION / POSITION</label>
                        <input asp-for="Position" class="form-control" placeholder="e.g. Lead Software Engineer" />
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="Salary" class="form-label small fw-bold text-muted">MONTHLY SALARY (₹) *</label>
                        <input asp-for="Salary" type="number" step="0.01" class="form-control" placeholder="0.00" required />
                        <span asp-validation-for="Salary" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Status" class="form-label small fw-bold text-muted">EMPLOYMENT STATUS</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Active">Active</option>
                            <option value="On Leave">On Leave</option>
                            <option value="Contractor">Contractor</option>
                            <option value="Former">Former</option>
                        </select>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="JoiningDate" class="form-label small fw-bold text-muted">JOINING DATE</label>
                    <input asp-for="JoiningDate" type="date" class="form-control" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                </div>

                <div class="d-flex justify-content-between pt-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save Employee</button>
                </div>
            </form>
        </div>
    </div>
</div>
